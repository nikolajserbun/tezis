# =============================================================================
# Тезис — образец окружения
# Скопируйте в .env и заполните свои значения. НИКОГДА не публикуйте .env.
# =============================================================================

# --- Приложение -------------------------------------------------------------
APP_NAME=Тезис
# dev | staging | prod
APP_ENV=dev
DEBUG=true
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# В prod выключить и использовать alembic upgrade head
AUTO_CREATE_TABLES=true
SENTRY_DSN=

# --- Адреса -----------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Безопасность ------------------------------------------------------------
# Сгенерируйте длинные случайные строки, например:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-64-char-secret-key-for-production-0000000000000000
JWT_SECRET=replace-with-random-64-char-hmac-key-for-production-00000000000000000000
WEBHOOK_SECRET=replace-with-random-64-char-webhook-token-for-production-00000000000

# Локальный демо-вход в админку и Mini App. В prod доступ запрещён.
DEV_ADMIN_EMAIL=owner@test.local
DEV_ADMIN_PASSWORD=test-password-123
# В prod должно быть false
DEV_PAYMENTS_ENABLED=true

# --- База данных и очередь ---------------------------------------------------
# Локально без Docker можно оставить SQLite:
DATABASE_URL=sqlite+aiosqlite:///./tezis.db
REDIS_URL=redis://localhost:6379/0

# Для Docker Compose раскомментируйте эти две строки:
# DATABASE_URL=postgresql+asyncpg://tezis:tezis@postgres:5432/tezis
# REDIS_URL=redis://redis:6379/0

POSTGRES_DB=tezis
POSTGRES_USER=tezis
POSTGRES_PASSWORD=tezis
# Нужен только для Caddy в prod
DOMAIN=tezis.example.com

# --- Telegram ----------------------------------------------------------------
# Токен выдаёт @BotFather. Храните только здесь, не отправляйте в чаты/репозиторий.
BOT_TOKEN=
BOT_USERNAME=tezis_ai_bot
# Единственный админ: ваш Telegram ID от @userinfobot
OWNER_TG_ID=1
# Чат для уведомлений команды (0 = выключено)
ADMIN_CHAT_ID=0
# Чат поддержки (0 = выключено)
SUPPORT_CHAT_ID=0
# Закрытый клуб (0 = выключено)
COMMUNITY_CHAT_ID=0
# polling | webhook. В prod по умолчанию webhook.
BOT_MODE=polling
# Явное разрешение polling в prod (используется, если вебхук недоставлен).
ALLOW_PROD_POLLING=false
# Например https://tezis.example.com
WEBHOOK_BASE_URL=

# --- AI ----------------------------------------------------------------------
# mock работает без ключа и детерминированно. Один и тот же провайдер используется
# в Студии, в чате Mini App и в диалоге с ИИ в Telegram-боте (/chat).
#
# Вариант А — бесплатно: Gemini API (ключ: https://aistudio.google.com/api-keys).
#   AI_PROVIDER=openai
#   AI_API_KEY=вставьте-ключ-в-.env-а-не-в-чат
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.5-flash-lite
#   (или gemini-3.8-flash для более качественных ответов — тоже бесплатно)
#   Важно: на бесплатном тарифе Google использует запросы для улучшения продуктов.
#
# Вариант Б — OpenRouter (каталог с бесплатными моделями):
#   AI_PROVIDER=openai
#   AI_API_KEY=...
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=айди-модели-с-суффиксом-:free-из-каталога-openrouter
#
# Вариант Б2 — Cloudflare Workers AI (10 000 Neurons/день бесплатно):
#   Токен: https://dash.cloudflare.com → Workers AI → Use REST API → Create API Token
#   Нужны права Workers AI: Read и Edit. Account ID там же на странице Workers AI.
#   AI_PROVIDER=cloudflare
#   AI_API_KEY=токен-созданный-в-Cloudflare
#   CLOUDFLARE_ACCOUNT_ID=ваш-account-id
#   Экономные модели на бесплатном тарифе (проверено на коротком запросе):
#     @cf/meta/llama-3.2-3b-instruct              ~0,47 Neuron  ← по умолчанию
#     @cf/mistralai/mistral-small-3.1-24b-instruct ~0,96 Neuron  ← лучше качество
#     @cf/meta/llama-3.3-70b-instruct-fp8-fast    ~1,69 Neuron  ← самая сильная
#   Дорогие reasoning-модели (@cf/google/gemma-4-26b-a4b-it ~3,5,
#   @cf/zai-org/glm-4.7-flash ~4,5, @cf/qwen/qwen3.8-27b ~15 Neurons) быстро
#   съедают дневную квоту — используйте их только для сложных задач.
#   Модели @cf/meta/llama-3.1-8b-instruct-fp8, @cf/meta/llama-3.2-1b-instruct
#   и @cf/qwen/qwen3-30b-a3b-fp8 объявлены устаревшими и возвращают 410.
#
# Вариант В — локальная модель Ollama без ключа и без интернета:
#   AI_PROVIDER=openai
#   AI_API_KEY=ollama
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2:3b
#
# Вариант Г — OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=...
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1800
AI_COST_PER_1K_MINOR=50
# Cloudflare сообщает Neurons в ответе. Для остальных провайдеров расход оцениваем по токенам.
AI_NEURONS_PER_1K_TOKENS=25
# Бесплатный доступ: 500 Neurons на аккаунт. Подписка не имеет Neuron-лимита
# (у платных тарифов остаётся лимит генераций из тарифа).
FREE_NEURONS=500
GENERATION_HISTORY_DAYS=30
# Устаревший счётчик, для совместимости
FREE_GENERATIONS=5
# Реальный поиск: Tavily (1000 бесплатных кредитов/мес), Serper или свой SearXNG.
# Без всех трёх чат работает в демо-режиме по встроенной базе знаний.
TAVILY_API_KEY=
SERPER_API_KEY=
# Адрес self-hosted SearXNG. В Docker используйте http://searxng:8080.
SEARXNG_URL=
# Секрет для своего SearXNG; в .env можно сгенерировать случайную строку.
SEARXNG_SECRET=dev-only-change-me

# --- Экономика ---------------------------------------------------------------
STARS_RUB_RATE=1.3
# 25 ₽ за первого друга, сделавшего запрос
REFERRAL_BONUS_MINOR=2500

# --- Файлы -------------------------------------------------------------------
ASSETS_DIR=assets

# --- Frontend (для сборки Docker) --------------------------------------------
# Пустой VITE_API_BASE = тот же домен, API проксируется Caddy/Nginx.
VITE_API_BASE=
VITE_BOT_USERNAME=tezis_ai_bot
VITE_ADMIN_TELEGRAM_LOGIN=
VITE_DEV_PAYMENTS=true
