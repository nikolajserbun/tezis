# =============================================================================
# Тезис — образец окружения
# Скопируйте в .env и заполните свои значения. НИКОГДА не публикуйте .env.
# =============================================================================

# --- Приложение -------------------------------------------------------------
APP_NAME=Тезис
APP_ENV=dev                         # dev | staging | prod
DEBUG=true
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true             # в prod выключить и использовать alembic upgrade head
SENTRY_DSN=

# --- Адреса -----------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Безопасность ------------------------------------------------------------
# Сгенерируйте длинные случайные строки, например:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-64-char-secret-key-for-production-0000000000000000
JWT_SECRET=replace-with-random-64-char-hmac-key-for-production-00000000000000000000
WEBHOOK_SECRET=replace-with-random-64-char-webhook-token-for-production-00000000000

# Локальный демо-вход в админку и Mini App. В prod доступ запрещён.
DEV_ADMIN_EMAIL=owner@test.local
DEV_ADMIN_PASSWORD=test-password-123
DEV_PAYMENTS_ENABLED=true           # в prod должно быть false

# --- База данных и очередь ---------------------------------------------------
# Локально без Docker можно оставить SQLite:
DATABASE_URL=sqlite+aiosqlite:///./tezis.db
REDIS_URL=redis://localhost:6379/0

# Для Docker Compose раскомментируйте эти две строки:
# DATABASE_URL=postgresql+asyncpg://tezis:tezis@postgres:5432/tezis
# REDIS_URL=redis://redis:6379/0

POSTGRES_DB=tezis
POSTGRES_USER=tezis
POSTGRES_PASSWORD=tezis
DOMAIN=tezis.example.com            # нужен только для Caddy в prod

# --- Telegram ----------------------------------------------------------------
# Токен выдаёт @BotFather. Храните только здесь, не отправляйте в чаты/репозиторий.
BOT_TOKEN=
BOT_USERNAME=tezis_ai_bot
OWNER_TG_ID=1                       # ваш Telegram ID — получите у @userinfobot
ADMIN_CHAT_ID=0                     # чат для уведомлений команды (0 = выключено)
SUPPORT_CHAT_ID=0                   # чат поддержки (0 = выключено)
COMMUNITY_CHAT_ID=0                 # закрытый клуб (0 = выключено)
BOT_MODE=polling                    # polling | webhook
WEBHOOK_BASE_URL=                   # например https://tezis.example.com

# --- AI ----------------------------------------------------------------------
# mock работает без ключа и детерминированно. Для реальных генераций:
# AI_PROVIDER=openai, AI_API_KEY=..., AI_MODEL=gpt-4o-mini
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1800
AI_COST_PER_1K_MINOR=50
GENERATION_HISTORY_DAYS=30
FREE_GENERATIONS=5
# Реальный поиск: Tavily (1000 бесплатных кредитов/мес), Serper или свой SearXNG.
# Без всех трёх чат работает в демо-режиме по встроенной базе знаний.
TAVILY_API_KEY=
SERPER_API_KEY=
# Адрес self-hosted SearXNG. В Docker используйте http://searxng:8080.
SEARXNG_URL=
# Секрет для своего SearXNG; в .env можно сгенерировать случайную строку.
SEARXNG_SECRET=dev-only-change-me

# --- Экономика ---------------------------------------------------------------
STARS_RUB_RATE=1.3
REFERRAL_BONUS_MINOR=2500           # 25 ₽ за первого друга, сделавшего запрос

# --- Файлы -------------------------------------------------------------------
ASSETS_DIR=assets

# --- Frontend (для сборки Docker) --------------------------------------------
# Пустой VITE_API_BASE = тот же домен, API проксируется Caddy/Nginx.
VITE_API_BASE=
VITE_BOT_USERNAME=tezis_ai_bot
VITE_ADMIN_TELEGRAM_LOGIN=
VITE_DEV_PAYMENTS=true
